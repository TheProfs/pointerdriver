{
  "name": "pointerdriver",
  "version": "1.0.0",
  "description": "Synthesizes DOMEvents from human-device interactions",
  "type": "module",
  "exports": "./index.js",
  "imports": {
    "#*": "./src/*/index.js",
    "#test/utils": "./test/utils/index.js"
  },
  "bin": {
    "pointerdriver": "bin/pointerdriver.js"
  },
  "files": [
    "index.js",
    "src/",
    "bin/",
    "fonts/",
    "docs/",
    "!docs/analysis.md",
    "!docs/spec/*.zip"
  ],
  "scripts": {
    "start": "node --title=pointerdriver ./bin/pointerdriver.js",
    "test": "node --test --test-concurrency=1 --test-timeout=5000 --import ./test/utils/setup.js \"**/*.test.js\""
  },
  "engines": { "node": ">=24" },
  "keywords": ["pointer", "pencil", "stylus", "touch", "simulate"],
  "author": "Nicholas Kyriakides",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^26.0.0"
  }
}
